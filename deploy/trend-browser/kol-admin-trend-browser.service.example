# Review paths and service user before installing. Replaces the backend service;
# do not run a second backend against the same profiles or listening port.
[Unit]
Description=KOL Admin with isolated Ads collection browsers
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kol-admin
Group=kol-admin
WorkingDirectory=/opt/kol-admin/backend
StateDirectory=kol-admin
StateDirectoryMode=0700
UMask=0077
Environment=TREND_BACKEND_BINARY=/opt/kol-admin/backend/kol-admin-server
Environment=TREND_BROWSER_PROFILE_ROOT=/var/lib/kol-admin/trend-browser-profiles
Environment=TREND_BROWSER_EXECUTABLE=/usr/bin/google-chrome-stable
Environment=TREND_BROWSER_MAX_SESSIONS=2
ExecStart=/opt/kol-admin/scripts/start-trend-browser-backend.sh
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=30
LimitCORE=0

[Install]
WantedBy=multi-user.target
