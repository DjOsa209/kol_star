# Preferred backend service. No Chrome, Xvfb, VNC or remote desktop on this server.
[Unit]
Description=KOL Admin with local-client trend uploads
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kol-admin
Group=kol-admin
WorkingDirectory=/opt/kol-admin/backend
StateDirectory=kol-admin
StateDirectoryMode=0700
UMask=0077
Environment=SERVER_ADDR=127.0.0.1:8080
Environment=TREND_BACKEND_BINARY=/opt/kol-admin/backend/kol-admin-server
Environment=TREND_LOCAL_STORAGE_ROOT=/var/lib/kol-admin/trend-local
Environment=TREND_LOCAL_CLIENT_DIR=/opt/kol-admin/backend/data/trend-clients
ExecStart=/opt/kol-admin/scripts/start-trend-local-backend.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
LimitCORE=0

[Install]
WantedBy=multi-user.target
